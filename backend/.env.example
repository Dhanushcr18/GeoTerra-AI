# Copy this file to backend/.env and add your NVIDIA NIM API key.
# Leave blank to run in offline/cached mode with deterministic fallbacks.
NVIDIA_API_KEY=

# NVIDIA NIM models (override if needed)
NIM_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NIM_VLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT_SECONDS=8.0

# Optional: force cached/offline mode even when key is present
GEOTERRA_OFFLINE_ONLY=false
